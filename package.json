{
  "name": "playwright-ts-sdet-framework",
  "version": "0.3.0",
  "private": true,
  "description": "Playwright + TypeScript UI tests for NovaBank (github.com/HrishiPurandare/novabank)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "report": "playwright show-report",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
